# =========================================================
# SECURITY TRAINING ACADEMY — environment variables
#
# Copy to .env.local for local work, and set the same names
# in Vercel under Project Settings > Environment Variables.
# Never commit real values. .env and .env.local are ignored.
# =========================================================

# ---------------------------------------------------------
# 1. PERSISTENT STORAGE  (required in production)
#
# Certificate records must survive a redeploy. Add the
# "Upstash for Redis" integration from the Vercel Marketplace
# and it sets these for you. Both naming schemes are accepted;
# you only need one pair.
# ---------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternative names, set by Upstash directly:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------
# 2. PUBLIC SITE URL  (optional)
#
# Set this to your custom domain once you have one, so the QR
# code on every certificate encodes the permanent address
# rather than the deployment URL it was generated on.
# No trailing slash.
# ---------------------------------------------------------
# PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------
# 3. ADMINISTRATOR ACCOUNT  (optional)
#
# Leave these unset and create the account through the
# one-time setup page at /admin-setup.html instead — that is
# the simpler route and the account is then held in storage.
#
# Set them only if you would rather provision the account
# entirely from the Vercel dashboard. An account created
# through the setup page always takes precedence.
#
# Generate the hash with:   npm run hash-password
# Generate the secret with: openssl rand -hex 32
# ---------------------------------------------------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=
